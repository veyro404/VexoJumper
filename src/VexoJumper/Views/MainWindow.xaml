<Window x:Class="VexoJumper.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Vexo Jumper" Width="1240" Height="800" MinWidth="980" MinHeight="660"
 Background="{StaticResource Bg}" FlowDirection="RightToLeft" FontFamily="./Assets/Fonts/#Vazirmatn"
 WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Cyan}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.Background>
   <RadialGradientBrush GradientOrigin="0.82,0.04" Center="0.82,0.04" RadiusX="0.85" RadiusY="0.8"><GradientStop Color="#142D4B" Offset="0"/><GradientStop Color="#0B1423" Offset="0.48"/><GradientStop Color="#080B13" Offset="1"/></RadialGradientBrush>
  </Grid.Background>
  <Grid Margin="22">
   <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" CornerRadius="24" Background="#D9101928" BorderBrush="#26364D" BorderThickness="1" Padding="15" Effect="{StaticResource SoftShadow}">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="6,7,6,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border x:Name="LogoTile" Width="42" Height="42" CornerRadius="14" Background="{StaticResource AccentGradient}" Effect="{StaticResource GlowShadow}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
        <Border.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.07" Duration="0:0:2.4"/><DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.07" Duration="0:0:2.4"/></Storyboard></BeginStoryboard></EventTrigger></Border.Triggers>
        <TextBlock Text="V" FontSize="27" FontWeight="Black" Foreground="#071321" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="VEXO" FontSize="21" FontWeight="Black"/><TextBlock Text="J U M P E R" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel>
      </Grid>
      <Border Height="1" Background="#26364D" Margin="0,20,0,0"/>
     </StackPanel>
     <StackPanel Grid.Row="2" Margin="0,3,0,0">
      <TextBlock Text="فضای کاری" Foreground="{StaticResource Muted}" FontSize="10" Margin="12,0,0,10"/>
      <Button Style="{StaticResource NavButton}" Content="◈   داشبورد" Tag="Dashboard" Click="Navigate_Click"/>
      <Button Style="{StaticResource NavButton}" Content="⌁   شبکه و DNS" Tag="Network" Click="Navigate_Click"/>
      <Button Style="{StaticResource NavButton}" Content="⌁   آزمایش Ping" Tag="Ping" Click="Navigate_Click"/>
      <Button Style="{StaticResource NavButton}" Content="⌕   جست‌وجوی DNS" Tag="Lookup" Click="Navigate_Click"/>
      <Button Style="{StaticResource NavButton}" Content="◷   پایش مصرف" Tag="Monitor" Click="Navigate_Click"/>
      <Border Height="1" Background="#26364D" Margin="8,16"/>
      <TextBlock Text="بیشتر" Foreground="{StaticResource Muted}" FontSize="10" Margin="12,0,0,10"/>
      <Button Style="{StaticResource NavButton}" Content="ⓘ   درباره برنامه" Tag="About" Click="Navigate_Click"/>
     </StackPanel>
     <StackPanel Grid.Row="3" Margin="5,12,5,4">
      <Border CornerRadius="14" Background="#101F32" BorderBrush="#263E5B" BorderThickness="1" Padding="12">
       <StackPanel><TextBlock Text="اتصال هوشمند" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="ابزارهای شبکه، ساده و دقیق" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
      </Border>
      <Button Margin="0,12,0,0" Padding="12,10" Background="#182A43" BorderBrush="#3B5D83"
       HorizontalContentAlignment="Center" Click="Github_Click" ToolTip="بازکردن مخزن Vexo Jumper در GitHub">
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Path Width="23" Height="23" Stretch="Uniform" Fill="#F2F7FF"
         Data="M12,0.5 C5.65,0.5 0.5,5.65 0.5,12 C0.5,17.1 3.8,21.4 8.4,22.9 C9,23 9.2,22.7 9.2,22.4 L9.2,20.3 C6,21 5.3,18.9 5.3,18.9 C4.8,17.6 4,17.2 4,17.2 C2.9,16.4 4.1,16.4 4.1,16.4 C5.3,16.5 5.9,17.7 5.9,17.7 C7,19.5 8.7,19 9.3,18.7 C9.4,17.9 9.7,17.4 10,17.1 C7.4,16.8 4.7,15.8 4.7,11.3 C4.7,10 5.2,8.9 5.9,8.1 C5.8,7.8 5.4,6.6 6,5 C6,5 7,4.7 9.3,6.2 C11.1,5.7 12.9,5.7 14.7,6.2 C17,4.7 18,5 18,5 C18.6,6.6 18.2,7.8 18.1,8.1 C18.9,8.9 19.3,10 19.3,11.3 C19.3,15.8 16.6,16.8 14,17.1 C14.4,17.4 14.7,18.1 14.7,19.1 L14.7,22.4 C14.7,22.7 14.9,23 15.5,22.9 C20.1,21.4 23.4,17.1 23.4,12 C23.4,5.65 18.25,0.5 12,0.5 Z"/>
        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
         <TextBlock Text="GitHub" FontSize="13" FontWeight="Bold"/>
         <TextBlock Text="مشاهده مخزن پروژه" FontSize="10" Foreground="{StaticResource Muted}"/>
        </StackPanel>
       </StackPanel>
      </Button>
      <TextBlock Text="نسخه ۱.۲.۰" Foreground="{StaticResource Muted}" FontSize="10" Margin="4,9,4,0" TextAlignment="Center"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="4,4,4,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="VEXO / NETWORK SUITE" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="PageTitle" Text="داشبورد" FontSize="27" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="کنترل اتصال، بدون پیچیدگی" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0"/></StackPanel>
     <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="20" Background="#142A29" BorderBrush="#28544D" BorderThickness="1" Padding="13,8">
      <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#52E0A6" Margin="0,0,8,0"><Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:1.15"/></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse><TextBlock x:Name="ConnectionBadge" Text="آماده به کار" Foreground="#8CF0C7" FontSize="11" FontWeight="SemiBold"/></StackPanel>
     </Border>
    </Grid>
    <Border Grid.Row="2" CornerRadius="23" Background="#A6101928" BorderBrush="#26364D" BorderThickness="1" Padding="17" Effect="{StaticResource SoftShadow}">
     <ContentControl x:Name="PageHost" Opacity="1"/>
    </Border>
   </Grid>
  </Grid>
  <Border Height="2" VerticalAlignment="Bottom" Background="{StaticResource AccentGradient}" Opacity="0.72"/>
 </Grid>
</Window>
