<Application x:Class="VexoJumper.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
 <Application.Resources>
  <Color x:Key="C.Bg">#080B13</Color>
  <Color x:Key="C.Surface">#101725</Color>
  <Color x:Key="C.Surface2">#151F30</Color>
  <Color x:Key="C.Surface3">#1B2940</Color>
  <Color x:Key="C.Line">#26364D</Color>
  <Color x:Key="C.Blue">#42A5FF</Color>
  <Color x:Key="C.Cyan">#50E0E5</Color>
  <SolidColorBrush x:Key="C.Text">#FFF2F7FF</SolidColorBrush>
  <Color x:Key="C.Muted">#8FA2BC</Color>
  <SolidColorBrush x:Key="Bg" Color="{StaticResource C.Bg}"/>
  <SolidColorBrush x:Key="Panel" Color="{StaticResource C.Surface}"/>
  <SolidColorBrush x:Key="Panel2" Color="{StaticResource C.Surface2}"/>
  <SolidColorBrush x:Key="Panel3" Color="{StaticResource C.Surface3}"/>
  <SolidColorBrush x:Key="Line" Color="{StaticResource C.Line}"/>
  <SolidColorBrush x:Key="Blue" Color="{StaticResource C.Blue}"/>
  <SolidColorBrush x:Key="Cyan" Color="{StaticResource C.Cyan}"/>
  <SolidColorBrush x:Key="Muted" Color="{StaticResource C.Muted}"/>
  <SolidColorBrush x:Key="TextBrush" Color="#FFF2F7FF"/>
  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#4CCBFF" Offset="0"/><GradientStop Color="#397BFF" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#17243A" Offset="0"/><GradientStop Color="#101725" Offset="1"/>
  </LinearGradientBrush>
  <DropShadowEffect x:Key="SoftShadow" Color="#000000" BlurRadius="24" ShadowDepth="8" Opacity="0.28"/>
  <DropShadowEffect x:Key="GlowShadow" Color="#287DFF" BlurRadius="22" ShadowDepth="0" Opacity="0.25"/>

  <Style TargetType="Window">
   <Setter Property="FontFamily" Value="./Assets/Fonts/#Vazirmatn"/>
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
   <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="FontFamily" Value="./Assets/Fonts/#Vazirmatn"/>
   <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EAF4FF"/><Setter Property="Background" Value="#1A2A41"/>
   <Setter Property="BorderBrush" Value="#2B4565"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="4"/>
   <Setter Property="FontFamily" Value="./Assets/Fonts/#Vazirmatn"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
     <Border.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#263E5D"/><Setter TargetName="Root" Property="BorderBrush" Value="#4A9FFF"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.13"/><DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.13"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16"/><DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.82"/><Setter TargetName="Root" Property="Background" Value="#315477"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.42"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="BorderBrush" Value="#5CCBFF"/><Setter Property="Foreground" Value="#061322"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,3"/><Setter Property="FontSize" Value="13"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1B2B42"/><Setter Property="BorderBrush" Value="#294D75"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="#0B1220"/>
   <Setter Property="BorderBrush" Value="#2A3C56"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="4,7"/>
   <Setter Property="FontFamily" Value="./Assets/Fonts/#Vazirmatn"/><Setter Property="CaretBrush" Value="{StaticResource Cyan}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost" Margin="2"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#48B9FF"/><Setter TargetName="Bd" Property="Effect" Value="{StaticResource GlowShadow}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="#0B1220"/><Setter Property="BorderBrush" Value="#2A3C56"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="4,7"/><Setter Property="FontFamily" Value="./Assets/Fonts/#Vazirmatn"/>
  </Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/><Setter Property="Background" Value="Transparent"/></Style>
 </Application.Resources>
</Application>
